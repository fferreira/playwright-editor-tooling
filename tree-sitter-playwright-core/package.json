{
  "name": "tree-sitter-playwright-core",
  "version": "0.1.0",
  "description": "Core Playwright grammar for tree-sitter",
  "license": "MIT",
  "main": "bindings/node",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "dependencies": {
    "nan": "*"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26"
  },
  "tree-sitter": [
    {
      "scope": "source.playwright-core",
      "file-types": [
        "core"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ]
}
